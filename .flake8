[flake8]
max-line-length = 88
extend-ignore = E203
exclude =
    .git,
    __pycache__,
    build,
    dist,
    tests/fixtures/
# Written by a script: its case names are the golden's, whole.
per-file-ignores =
    tests/harness_changes_notice_query.py: E501
    tests/harness_changes_resolvefirst.py: E501

# Interim ratchets set to the exact current repo max (tightest ceiling
# that still passes) — see working-docs/design/complexity-and-file-size-roadmap.md
# for the backlog. Never raise either value; re-measure across src/, tests/,
# scripts/, benchmarks/ and tools/ before lowering one.
# target: 10 (currently 12, identifiers.read_leading)
max-complexity = 12
# target: 15 (currently 29: identifiers.read_leading,
# tests/test_accuracy.py::run_accuracy_test, tools/licence_sample/__main__.py)
max-cognitive-complexity = 29
